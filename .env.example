# Sepolia RPC endpoint
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Merchant wallet that receives USDC payments
MERCHANT_ADDRESS=0x006450335E618A9Fae2ad89542af411C8668d87D
MERCHANT_PRIVATE_KEY=

# Test buyer wallet for automated E2E tests (see config/test-wallets.env)
TEST_BUYER_ADDRESS=0xE432A39eA2303dD8DD71C4afEc65AFa904AfB6Cb
TEST_BUYER_PRIVATE_KEY=

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Set to 0 to require a real on-chain USDC transfer
DEMO_AUTO_PAY=1
DEMO_AUTO_PAY_MS=8000

# HMAC for signed order ids. Falls back to ADMIN_PASSWORD.
ORDER_SECRET=vouchershop-demo

# App URL for E2E scripts
APP_URL=http://localhost:3000
