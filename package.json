{
  "name": "voucher-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:anvil": "bash scripts/start-anvil-shop.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup:env": "node scripts/setup-env.mjs",
    "test:e2e": "node --env-file=.env.local scripts/fund-fork.mjs && node --env-file=.env.local scripts/e2e-purchase.mjs",
    "test:e2e:ten": "node --env-file=config/test-wallets.env --env-file=config/anvil.env scripts/e2e-ten-buyers.mjs",
    "verify:purchase": "node scripts/verify-purchase.mjs",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@scure/bip32": "^1.7.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
